# RelayRoster for permanent use, with sign-in via OIDC. Copy to .env next to compose.yaml:
#   cp .env.example .env
# These are start values only: everything except sign-in, DATA_DIR and LOG_LEVEL can be changed
# in the app under Settings and is stored in /data.

# ---- Sign-in (OIDC) --------------------------------------------------------------------------
# Any OpenID Connect provider works (e.g. Pocket ID, Authentik, Keycloak, Authelia).
# Create a confidential client with PKCE and the callback URL from OIDC_REDIRECT_URI.
# Exactly the "issuer" from <issuer>/.well-known/openid-configuration, without trailing slash
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=relayroster
# The client secret is read from the file secrets/oidc_client_secret (see compose.yaml).
# OIDC_CLIENT_SECRET=   # alternatively directly here, but then it is visible in `docker inspect`
# Must match the callback URL registered at the provider exactly
OIDC_REDIRECT_URI=https://relayroster.example.com/auth/callback
# Label of the sign-in button ("Sign in with …")
OIDC_PROVIDER_NAME=SSO
# Only members of these groups (comma-separated); empty = everyone the provider signs in for this client
OIDC_ALLOWED_GROUPS=
# Extra root certificate (PEM, line breaks as \n) if the provider uses a private CA
OIDC_CA_CERT=

# ---- Network ---------------------------------------------------------------------------------
# Networks to scan for Shelly devices (CIDR, comma-separated, at most /16 per network).
# A /16 takes up to 13 minutes with the defaults, a /24 a few seconds.
SCAN_NETWORKS=192.168.1.0/24
# Additional single addresses, e.g. devices outside these networks
EXTRA_HOSTS=

# Read all devices every 15 minutes, rescan the network on every 4th run (hourly).
# SCAN_EVERY_N_POLLS=0: never scan automatically, only via "Scan network".
POLL_INTERVAL_MINUTES=15
SCAN_EVERY_N_POLLS=4
# Parallel connections during a scan and timeout per address
SCAN_CONCURRENCY=128
SCAN_TIMEOUT_SECONDS=1.5

# ---- Devices ---------------------------------------------------------------------------------
# Device password (digest auth, user admin) is read from secrets/shelly_password (see compose.yaml).
# Leave that file empty while your devices have none.

# Write functions, all off by default. Apart from these four, nothing is ever written to a device.
# Start firmware updates from the UI (Shelly.Update, channel stable or beta)
ALLOW_FIRMWARE_UPDATE=false
# Restart a device from its detail page (Shelly.Reboot without parameters)
ALLOW_REBOOT=false
# Set the device password on devices without one (Shelly.SetAuth)
ALLOW_SET_PASSWORD=false
# Edit configuration on the device page (<Component>.SetConfig, only fields from the allow list)
ALLOW_CONFIG=false

# ---- Other -----------------------------------------------------------------------------------
# Sidebar as an icon bar that expands on hover. false = always expanded (changeable in Settings)
SIDEBAR_FOLDED=false
# Configuration snapshots kept per device
SNAPSHOTS_KEEP=100
LOG_LEVEL=INFO
TZ=UTC
