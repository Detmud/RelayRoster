# RelayRoster quick start. Copy to .env:   cp .env.example .env
#
# ############################################################################################
# #                                                                                          #
# #   WARNING: THIS SETUP HAS NO SIGN-IN.                                                    #
# #                                                                                          #
# #   Anyone who can reach port 8746 can see your devices and use every write function       #
# #   you switch on in Settings (firmware updates, restarts, configuration, passwords).      #
# #                                                                                          #
# #   Fine for a first look in your own network. Before you keep it running, set up          #
# #   sign-in: see examples/production/ and docs/installation.md ("Run it permanently").     #
# #   Never expose this setup to the internet.                                              #
# #                                                                                          #
# ############################################################################################

# The network(s) your Shelly devices are in (CIDR, comma-separated, at most /16 each).
# You can change this later in the app under Settings, no restart needed.
SCAN_NETWORKS=192.168.1.0/24

# Device password (digest auth, user admin). Leave empty if your devices have none.
SHELLY_PASSWORD=
